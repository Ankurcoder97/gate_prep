# Node.js Server Environment Variables
NODE_ENV=production
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/gate_assessment?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_production_secure_jwt_secret_key_random_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Client Origin (e.g. Vercel deployment URL)
CLIENT_URL=https://your-gate-platform.vercel.app
ALLOWED_ORIGINS=https://your-gate-platform.vercel.app,http://localhost:5173
